# Which reasoning backend to use: "openai_compatible" (default - Google ADK
# routed via LiteLLM to any OpenAI-compatible chat-completions endpoint,
# much cheaper than Claude) or "claude" (the Claude Agent SDK, with web
# search enabled).
AGENT_PROVIDER=openai_compatible

# Required when AGENT_PROVIDER=openai_compatible: the endpoint's API key,
# base URL, and the plain model id it expects. Works with any provider that
# speaks the OpenAI chat-completions API - examples:
#   DeepSeek:      https://api.deepseek.com/v1        deepseek-chat
#   Qwen (Alibaba): https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   Zhipu GLM:      https://open.bigmodel.cn/api/paas/v4               glm-4
#   Moonshot Kimi:  https://api.moonshot.cn/v1                          moonshot-v1-8k
#   Self-hosted vLLM/Ollama: http://localhost:11434/v1                  <your model>
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Claude Agent SDK (named distinctly from ANTHROPIC_API_KEY so it doesn't
# collide with a locally-set ANTHROPIC_API_KEY used by the Claude Code CLI).
# Only required when AGENT_PROVIDER=claude.
INVESTMENT_AGENT_ANTHROPIC_API_KEY=

# Internal price data API (source of truth for all asset prices).
# Defaults to BMoney's public bullion price API, used by the gold plugin.
INTERNAL_PRICE_API_URL=https://api.bmoney.id

# Logging
LOG_LEVEL=INFO
