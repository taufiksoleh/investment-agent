# Which reasoning backend to use: "deepseek" (default - Google ADK routed via
# LiteLLM to DeepSeek's OpenAI-compatible API, much cheaper) or "claude" (the
# Claude Agent SDK, with web search enabled).
AGENT_PROVIDER=deepseek

# DeepSeek API key (https://platform.deepseek.com/api_keys), required when
# AGENT_PROVIDER=deepseek. Optional model override: DEEPSEEK_MODEL
# (defaults to deepseek/deepseek-chat; deepseek/deepseek-reasoner for
# heavier chain-of-thought reasoning).
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek/deepseek-chat

# Claude Agent SDK (named distinctly from ANTHROPIC_API_KEY so it doesn't
# collide with a locally-set ANTHROPIC_API_KEY used by the Claude Code CLI).
# Only required when AGENT_PROVIDER=claude.
INVESTMENT_AGENT_ANTHROPIC_API_KEY=

# Internal price data API (source of truth for all asset prices).
# Defaults to BMoney's public bullion price API, used by the gold plugin.
INTERNAL_PRICE_API_URL=https://api.bmoney.id

# Logging
LOG_LEVEL=INFO
